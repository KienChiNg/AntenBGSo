  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "B\xE0i to\xE1n b\u1EE9c x\u1EA1 v\xF4 h\u01B0\u1EDBng:\r\n\u2022 Kh\xF4ng
    gian t\u1EF1 do, m\xF4i tr\u01B0\u1EDDng \u0111\u1ED3ng nh\u1EA5t, \u0111\u1EB3ng
    h\u01B0\u1EDBng, kh\xF4ng h\u1EA5p th\u1EE5\r\n\u2022 Ngu\u1ED3n b\u1EE9c x\u1EA1
    v\xF4 h\u01B0\u1EDBng, c\xF4ng su\u1EA5t b\u1EE9c x\u1EA1 P<sub>\u03A3</sub>(W), 
    \u0111\u1EB7t t\u1EA1i \u0111i\u1EC3m A\r\n\u2022 X\xE9t tr\u01B0\u1EDDng t\u1EA1i
    \u0111i\u1EC3m M c\xE1ch A m\u1ED9t kho\u1EA3ng r(m)\r\n\r\n Gi\u1EA3i quy\u1EBFt:\r\n\u2022
    Ngu\u1ED3n b\u1EE9c x\u1EA1 s\u1EBD b\u1EE9c x\u1EA1 v\xF4 s\u1ED1 m\u1EB7t s\xF3ng
    c\u1EA7u li\xEAn ti\u1EBFp c\xF3 t\xE2m t\u1EA1i A\r\n\u2022 X\xE9t m\u1EB7t
    c\u1EA7u \u0111i qua M c\xF3 b\xE1n k\xEDnh l\xE0 r. Th\xF4ng l\u01B0\u1EE3ng
    n\u0103ng l\u01B0\u1EE3ng (m\u1EADt \u0111\u1ED9 c\xF4ng su\u1EA5t) t\u1EA1i
    m\u1EB7t c\u1EA7u:\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b59f674d68a3a574aa1453f19a738780, type: 2}
