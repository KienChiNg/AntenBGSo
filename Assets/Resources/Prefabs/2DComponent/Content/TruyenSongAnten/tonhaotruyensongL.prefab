  m_RaycastTarget: 1
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Khi s\xF3ng v\xF4 tuy\u1EBFn \u0111i\u1EC7n truy\u1EC1n trong m\u1ED9t
    m\xF4i tr\u01B0\u1EDDng, ngo\xE0i t\u1ED5n hao do m\xF4i tr\u01B0\u1EDDng g\xE2y
    ra nh\u01B0 b\u1ECB h\u1EA5p th\u1EE5 trong c\xE1c ph\xE2n t\u1EED kh\xED, trong
    h\u01A1i n\u01B0\u1EDBc,..., t\u1ED5n hao do t\xE1n x\u1EA1 do m\xE2y m\u01B0a,
    do v\u1EADt ch\u1EAFn,v.v... th\xEC s\u1EF1 suy hao l\u1EDBn nh\u1EA5t ch\xEDnh
    l\xE0 do s\u1EF1 khu\xEAch t\xE1n t\u1EA5t y\u1EBFu c\u1EE7a s\xF3ng ra m\u1ECDi
    ph\u01B0\u01A1ng v\xE0 \u0111\u01B0\u1EE3c g\u1ECDi l\xE0 t\u1ED5n hao kh\xF4ng
    gian t\u1EF1 do.\r\n\u2022 N\u1EBFu ta b\u1EE9c x\u1EA1 ra m\xF4i tr\u01B0\u1EDDng
    m\u1ED9t c\xF4ng su\u1EA5t P, anten ch\u1EC9 thu nh\u1EADn \u0111\u01B0\u1EE3c
    m\u1ED9t c\xF4ng su\u1EA5t PR, th\xEC h\u1EC7 s\u1ED1 t\u1ED5n hao truy\u1EC1n
    s\xF3ng \u0111\u01B0\u1EE3c \u0111\u1ECBnh ngh\u0129a b\u1EB1ng t\u1EC9 s\u1ED1
    c\u1EE7a c\xF4ng su\u1EA5t b\u1EE9c x\u1EA1 tr\xEAn c\xF4ng su\u1EA5t anten thu
    nh\u1EADn \u0111\u01B0\u1EE3c:\r"
