  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1464612539933694126}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Trong c\xF4ng th\u1EE9c h\u1EC7 s\u1ED1 G \u1EDF h\u01B0\u1EDBng tia t\u1EDBi
    v\xE0 tia ph\u1EA3n x\u1EA1 coi nh\u01B0 b\u1EB1ng nhau v\xE0 b\u1EB1ng G<size=9>T</size>,
    v\xEC trong th\u1EF1c t\u1EBF m\u1ED9t tuy\u1EBFn vi ba bao gi\u1EDD c\u0169ng
    th\u1ECFa m\xE3n \u0111i\u1EC1u ki\u1EC7n \u0111\u1ED9 cao anten h<size=10>t</size>,
    h<size=10>r</size> <<r, b\u1EDFi v\u1EADy ph\u01B0\u01A1ng b\u1EE9c x\u1EA1 c\u1EE7a
    2 tia r1 v\xE0 r2 g\u1EA7n nh\u01B0 tr\xF9ng nhau.\r\n\nC\u0169ng v\xEC r >>h<size=10>t</size>,h<size=10>r</size>
    n\xEAn c\xF3 th\u1EC3 coi r1 \u2248 r2 \u2248 r, \u1EDF ph\u1EA7n bi\xEAn \u0111\u1ED9.
    Nh\u01B0ng v\xEC b\u01B0\u1EDBc s\xF3ng c\xF4ng t\xE1c \u1EDF gi\u1EA3i s\xF3ng
    vi ba r\u1EA5t b\xE9, g\xF3c sai pha do \u0111\u01B0\u1EDDng \u0111i kh\xE1c
    nhau gi\u1EEFa tia tr\u1EF1c ti\u1EBFp v\xE0 tia ph\u1EA3n x\u1EA1 l\u1EA1i kh\xF4ng
    th\u1EC3 b\u1ECF qua \u0111\u01B0\u1EE3c v\xEC \u03BB\u2248\u0394r.\r\n\u2022
    C\u01B0\u1EDDng \u0111\u1ED9 \u0111i\u1EC7n tr\u01B0\u1EDDng do tia tr\u1EF1c
    ti\u1EBFp (mV / m):"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e8b9751211da3841a79ddd9649315a5, type: 2}
