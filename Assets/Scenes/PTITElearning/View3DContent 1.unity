  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 3071cd5fce2981342a5c0e8d5ec12147, type: 3}
    m_FontSize: 12
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\tCh\u1EA5t b\xE1n d\u1EABn lo\u1EA1i P (ch\u1EA5t b\xE1n d\u1EABn kh\xF4ng
    thu\u1EA7n lo\u1EA1i nh\u1EADn)\r:\n\tTh\xEAm m\u1ED9t \xEDt t\u1EA1p ch\u1EA5t
    l\xE0 nguy\xEAn t\u1ED1 thu\u1ED9c nh\xF3m 3, th\xED d\u1EE5: In, Bo, Ga\u2026
    v\xE0o ch\u1EA5t b\xE1n d\u1EABn thu\u1EA7n Ge ho\u1EB7c Si. Trong n\xFAt m\u1EA1ng
    nguy\xEAn t\u1EED t\u1EA1p ch\u1EA5t ch\u1EC9 c\xF3 3 \u0111i\u1EC7n t\u1EED
    h\xF3a tr\u1ECB \u0111\u01B0a ra t\u1EA1o li\xEAn k\u1EBFt c\u1ED9ng h\xF3a tr\u1ECB
    v\u1EDBi 3 nguy\xEAn t\u1EED Ge (ho\u1EB7c Si) \u1EDF b\xEAn c\u1EA1nh, m\u1ED1i
    li\xEAn k\u1EBFt th\u1EE9 4 \u0111\u1EC3 tr\u1ED1ng v\xE0 t\u1EA1o th\xE0nh m\u1ED9t
    l\u1ED7 tr\u1ED1ng. \u0110i\u1EC7n t\u1EED c\u1EE7a m\u1ED1i li\xEAn k\u1EBFt
    g\u1EA7n \u0111\xF3 c\xF3 th\u1EC3 nh\u1EA3y sang \u0111\u1EC3 ho\xE0n ch\u1EC9nh
    m\u1ED1i li\xEAn k\u1EBFt th\u1EE94 c\xF2n \u0111\u1EC3 tr\u1ED1ng \u0111\xF3.
    \r\n\tNguy\xEAn t\u1EED t\u1EA1p ch\u1EA5t v\u1EEBa nh\u1EADn th\xEAm \u0111i\u1EC7n
    t\u1EED s\u1EBD tr\u1EDF th\xE0nh ion \xE2m v\xE0 ng\u01B0\u1EE3c l\u1EA1i \u1EDF
    nguy\xEAn t\u1EED Ge/Si v\u1EEBa c\xF3 1 \u0111i\u1EC7n t\u1EED chuy\u1EC3n \u0111i
    s\u1EBD t\u1EA1o ra m\u1ED9t l\u1ED7 tr\u1ED1ng v\xE0 nguy\xEAn t\u1EED n\xE0y
    s\u1EBD tr\u1EDF th\xE0nh ion d\u01B0\u01A1ng c\u1ED1 \u0111\u1ECBnh.\r\n"
