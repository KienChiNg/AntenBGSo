  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 3071cd5fce2981342a5c0e8d5ec12147, type: 3}
    m_FontSize: 12
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "- \u0110i\u1EC7n th\u1EBF ti\u1EBFp x\xFAc trong t\u0103ng.\r\n- \u0110i\u1EC7n
    tr\u01B0\u1EDDng ti\u1EBFp x\xFAc t\u0103ng.\r\n- \u0110\u1ED9 r\u1ED9ng v\xF9ng
    \u0111i\u1EC7n t\xEDch kh\xF4ng gian t\u0103ng\r\nDo \u0111i\u1EC7ntr\u01B0\u1EDDng
    c\u1EE7a l\u1EDBp ti\u1EBFp x\xFAc t\u0103ng l\xEAn s\u1EBD th\xFAc \u0111\u1EA9y
    qu\xE1 tr\xECnh chuy\u1EC3n \u0111\u1ED9ng tr\xF4i c\u1EE7a c\xE1c h\u1EA1t d\u1EABn
    thi\u1EC3u s\u1ED1 qua chuy\u1EC3n ti\u1EBFp P-N, t\u1EA1o n\xEAn d\xF2ng \u0111i\u1EC7n
    tr\xF4i c\xF3 chi\u1EC1u t\u1EEB b\xE1n d\u1EABn N sang b\xE1n d\u1EABn P v\xE0
    \u0111\u01B0\u1EE3c g\u1ECDi l\xE0 d\xF2ng \u0111i\u1EC7n ng\u01B0\u1EE3c Ing\u01B0\u1EE3c.
    \r\n- N\u1EBFu ta t\u0103ng \u0111i\u1EC7n \xE1p ng\u01B0\u1EE3c l\xEAn, hi\u1EC7u
    \u0111i\u1EC7n th\u1EBF ti\u1EBFp x\xFAc c\xE0ng t\u0103ng l\xEAn l\xE0m cho
    d\xF2ng \u0111i\u1EC7n ng\u01B0\u1EE3c t\u0103ng l\xEAn. nh\u01B0ng do n\u1ED3ng
    \u0111\u1ED9 c\xE1c h\u1EA1t d\u1EABn thi\u1EC3u s\u1ED1 r\u1EA5t nh\u1ECF, n\xEAn
    d\xF2ng \u0111i\u1EC7n ng\u01B0\u1EE3c nhanh ch\xF3ng \u0111\u1EA1t gi\xE1 tr\u1ECB
    b\xE3o h\xF2a n\xE0o \u0111\xF3 v\xEC th\u1EBF n\xF3 c\xF2n \u0111\u01B0\u1EE3c
    g\u1ECDi l\xE0 d\xF2ng \u0111i\u1EC7n ng\u01B0\u1EE3c b\xE3o h\xF2a IS c\xF3
    gi\xE1 tr\u1ECB r\u1EA5t nh\u1ECF.\r\n"
