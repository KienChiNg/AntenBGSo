--- !u!114 &682115732
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 682115730}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 3071cd5fce2981342a5c0e8d5ec12147, type: 3}
    m_FontSize: 12
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "- \u0110i\u1EC7n th\u1EBF ti\u1EBFp x\xFAc trong gi\u1EA3m.\r\n- \u0110i\u1EC7n
    tr\u01B0\u1EDDng ti\u1EBFp x\xFAc gi\u1EA3m.\r\n- \u0110\u1ED9 r\u1ED9ng v\xF9ng
    \u0111i\u1EC7n t\xEDch kh\xF4ng gian gi\u1EA3m\r\nPh\u1EA7n l\u1EDBn c\xE1c h\u1EA1t
    d\u1EABn \u0111a s\u1ED1 c\xF3 n\u0103ng l\u01B0\u1EE3ng \u0111\u1EE7 l\u1EDBn
    d\u1EC5 d\xE0ng khu\u1EBFch t\xE1n qua CT P-N. K\u1EBFt qu\u1EA3 l\xE0 d\xF2ng
    \u0111i\u1EC7n qua CT P-N t\u0103ng l\xEAn v\xE0 \u0111\xE2y l\xE0 th\xE0nh ph\u1EA7n
    d\xF2ng \u0111i\u1EC7n khu\u1EBFch t\xE1n. D\xF2ng \u0111i\u1EC7nch\u1EA1y qua
    ch\u1EA1y qua ti\u1EBFp x\xFAc P-N khi n\xF3 ph\xE2n c\u1EF1c thu\u1EADn g\u1ECDi
    l\xE0 d\xF2ng \u0111i\u1EC7n thu\u1EADn Ith.\r\n+ Nh\u1EEFng h\u1EA1t d\u1EABn
    \u0111a s\u1ED1 sau khi v\u01B0\u1EE3t qua l\u1EDBp ti\u1EBFp x\xFAc P-N v\xE0o
    c\xE1c ph\u1EA7n b\xE1n d\u1EABn P v\xE0 N th\xEC ch\xFAng tr\u1EDF th\xE0nh
    c\xE1c h\u1EA1t d\u1EABn thi\u1EC3u s\u1ED1 c\u1EE7a c\xE1c ch\u1EA5t b\xE1n
    d\u1EABn n\xE0y, nh\u01B0 v\u1EADy c\xF3 hi\u1EC7n t\u01B0\u1EE3ng \u201Cphun\"
    c\xE1c h\u1EA1t d\u1EABn thi\u1EC3u s\u1ED1 qua v\xF9ng \u0111i\u1EC7n t\xEDch
    kh\xF4ng gian.\r\n+ Khi t\u0103ng \u0111i\u1EC7n \xE1p thu\u1EADn l\xEAn, ti\u1EBFp
    x\xFAc P-N \u0111\u01B0\u1EE3c ph\xE2n c\u1EF1c thu\u1EADn c\xE0ng m\u1EA1nh,
    hi\u1EC7u \u0111i\u1EC7n th\u1EBF ti\u1EBFp x\xFAc c\xE0ng gi\u1EA3m, h\xE0ng
    r\xE0o th\u1EBF n\u0103ng c\xE0ng th\u1EA5p xu\u1ED1ng, c\xE1c h\u1EA1t d\u1EABn
    \u0111a s\u1ED1 khu\u1EBFch t\xE1n qua ti\u1EBFp x\xFAc P-N c\xE0ng nhi\u1EC1u
    n\xEAn d\xF2ng \u0111i\u1EC7n thu\u1EADn c\xE0ng t\u0103ng v\xE0 n\xF3 t\u0103ng
    theo qui lu\u1EADt h\xE0m s\u1ED1 m\u0169 v\u1EDBi \u0111i\u1EC7n \xE1p ngo\xE0i.\r\n"
