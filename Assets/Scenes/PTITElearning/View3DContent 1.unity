  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 3071cd5fce2981342a5c0e8d5ec12147, type: 3}
    m_FontSize: 12
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "Ch\u1EA5t b\xE1n d\u1EABn thu\u1EA7n:\r\n- Ch\u1EA5t b\xE1n d\u1EABn m\xE0
    \u1EDF m\u1ED7i n\xFAt c\u1EE7a m\u1EA1ng tinh th\u1EC3 c\u1EE7a n\xF3 ch\u1EC9
    c\xF3 nguy\xEAn t\u1EED c\u1EE7a m\u1ED9tlo\u1EA1i nguy\xEAn t\u1ED1, v\xED 
    d\u1EE5 nh\u01B0 c\xE1c tinh th\u1EC3 Ge (gecmani) Si (silic) nguy\xEAn ch\u1EA5t
    ..\r\n\r\nS\u1EF1 t\u1EA1o th\xE0nh l\u1ED7 tr\u1ED1ng v\xE0 \u0111i\u1EC7n t\u1EED
    t\u1EF1 do:\r\n- \u1EDE nhi\u1EC7t \u0111\u1ED9 ph\xF2ng, m\u1ED9t s\u1ED1 li\xEAn
    k\u1EBFt c\u1ED9ng h\xF3a tr\u1ECB b\u1ECB ph\xE1 v\u1EE1 t\u1EA1o ra \u0111i\u1EC7n
    t\u1EED t\u1EF1 do v\xE0 l\u1ED7 tr\u1ED1ng.\r\n- L\u1ED7 tr\u1ED1ng c\u0169ng
    c\xF3 kh\u1EA3 n\u0103ng d\u1EABn \u0111i\u1EC7n nh\u01B0 \u0111i\u1EC7n t\u1EED
    t\u1EF1 do, mang \u0111i\u1EC7n t\xEDch v\xE0 c\xF3 c\xF9ng \u0111\u1ED9 l\u1EDBn
    v\u1EDBi \u0111i\u1EC7n t\xEDch \u0111i\u1EC7n t\u1EED.\r\n- B\xE1n d\u1EABn
    thu\u1EA7n c\xF3 n\u1ED3ng \u0111\u1ED9 h\u1EA1t d\u1EABn l\u1ED7 tr\u1ED1ng
    v\xE0 n\u1ED3ng \u0111\u1ED9 h\u1EA1t d\u1EABn \u0111i\u1EC7n t\u1EED b\u1EB1ng
    nhau: \r\n"
