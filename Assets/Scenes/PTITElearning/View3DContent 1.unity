--- !u!114 &502943620
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 502943618}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 3071cd5fce2981342a5c0e8d5ec12147, type: 3}
    m_FontSize: 12
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "Chuy\u1EC3n ti\u1EBFp P-N \u1EDF tr\u1EA1ng th\xE1i c\xE2n b\u1EB1ng nhi\u1EC7t\r:\n\t-
    Khi ti\u1EBFp x\xFAc P-N \u0111\u01B0\u1EE3c h\xECnh th\xE0nh, do s\u1EF1 ch\xEAnh
    l\u1EC7ch n\u1ED3ng \u0111\u1ED9 n\xEAn s\u1EBD c\xF3 s\u1EF1 khu\u1EBFch t\xE1n
    \u0111i\u1EC7n t\u1EED\r v\xE0 l\u1ED7 tr\u1ED1ng qua b\u1EC1 m\u1EB7t ti\u1EBFp
    x\xFAc v\xE0 ch\xFAng t\xE1i h\u1EE3p v\u1EDBi nhau.\r\n\t- Mi\u1EC1n l\xE2n
    c\u1EADn m\u1EB7t ti\u1EBFp x\xFAc m\u1EA5t \u0111\u1EB7c t\xEDnh trung h\xF2a
    v\u1EC1 \u0111i\u1EC7n, b\xEAn b\xE1n n d\u1EABn t\xEDch \u0111i\u1EC7n +, b\xEAn
    b\xE1n d\u1EABn p t\xEDch \u0111i\u1EC7n \u2013, t\u1EA1o th\xE0nh mi\u1EC1n
    \u0111i\u1EC7n t\xEDch kh\xF4ng gian v\xE0 h\xECnh th\xE0nh m\u1ED9t \u0111i\u1EC7n
    tr\u01B0\u1EDDng n\u1ED9i Et\r\n\t- Et l\u1EA1i l\xE0m t\u0103ng s\u1EF1 cu\u1ED1n
    c\u1EE7a c\xE1c h\u1EA1t d\u1EABn thi\u1EC3u s\u1ED1 c\u1EE7a 2 l\u1EDBp b\xE1n
    d\u1EABn qua ti\u1EBFp gi\xE1p t\u1EA1o ra d\xF2ng \u0111i\u1EC7n tr\xF4i.\r\n\t-
    Chuy\u1EC3n ti\u1EBFp P-N \u0111\u1EA1t tr\u1EA1ng th\xE1i c\xE2n b\u1EB1ng khi
    d\xF2ng khu\u1EBFch t\xE1n Jdiff b\u1EB1ng d\xF2ng tr\xF4i Jdriff. V\u1EADy trong
    ti\u1EBFp gi\xE1p P-N h\xECnh th\xE0nh 3 v\xF9ng:\r\n\t- 1 v\xF9ng \u0111i\u1EC7n
    t\xEDch kh\xF4ng gian\r\n\t- 2 v\xF9ng b\xE1n d\u1EABn n, p c\u1EADn trung h\xF2a\r\n"
