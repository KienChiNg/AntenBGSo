--- !u!114 &660878115
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 660878113}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u1EE8ng d\u1EE5ng n\xE0y m\xF4 ph\u1ECFng s\xF3ng \u0111i\u1EC7n t\u1EEB
    trong m\xF4i tr\u01B0\u1EDDng ch\xE2n kh\xF4ng v\xE0 trong v\u1EADt ch\u1EA5t.
    \u0110\u1EC3 d\u1EC5 hi\u1EC3u, ch\u1EC9 c\xF3 th\xE0nh ph\u1EA7n \u0111i\u1EC7n
    \u0111\u01B0\u1EE3c hi\u1EC3n th\u1ECB m\u1ECDi l\xFAc (th\xE0nh ph\u1EA7n t\u1EEB
    lu\xF4n vu\xF4ng g\xF3c v\u1EDBi th\xE0nh ph\u1EA7n \u0111i\u1EC7n v\xE0 \u0111\u1ED9
    l\u1EDBn c\u1EE7a n\xF3 dao \u0111\u1ED9ng theo c\xF9ng pha v\u1EDBi th\xE0nh
    ph\u1EA7n \u0111i\u1EC7n).\n\nTrong \u1EE9ng d\u1EE5ng, b\u1EA1n c\xF3 th\u1EC3
    thi\u1EBFt l\u1EADp hai s\xF3ng (S\xF3ng 1 v\xE0 S\xF3ng 2) v\u1EDBi s\u1EF1
    ph\xE2n c\u1EF1c c\xF3 th\u1EC3 ch\u1ECDn (ngang, d\u1ECDc, ph\xE2n c\u1EF1c
    tr\xF2n tr\xE1i ho\u1EB7c ph\xE2n c\u1EF1c tr\xF2n ph\u1EA3i) v\xE0 b\u1EA1n
    c\xF3 th\u1EC3 hi\u1EC3n th\u1ECB s\u1EF1 ch\u1ED3ng ch\u1EA5t c\u1EE7a ch\xFAng
    (S\xF3ng 1 + S\xF3ng 2). C\xE1c s\xF3ng khi di chuy\u1EC3n v\u1EC1 ph\xEDa tr\u01B0\u1EDBc
    \u0111\u01B0\u1EE3c hi\u1EC3n th\u1ECB gi\u1EEFa hai m\u1EB7t ph\u1EB3ng; c\xE1c
    vector c\u1EE7a \u0111i\u1EC7n tr\u01B0\u1EDDng \u0111\u01B0\u1EE3c hi\u1EC3n
    th\u1ECB t\u1EA1i c\xE1c m\u1EB7t ph\u1EB3ng. B\u1EB1ng c\xE1ch s\u1EED d\u1EE5ng
    c\xE1c \u0111i\u1EC1u khi\u1EC3n, b\u1EA1n c\xF3 th\u1EC3 \u0111i\u1EC1u ch\u1EC9nh
    bi\xEAn \u0111\u1ED9 v\xE0 b\u01B0\u1EDBc s\xF3ng c\u1EE7a c\xE1c s\xF3ng c\u0169ng
    nh\u01B0 s\u1EF1 kh\xE1c pha gi\u1EEFa ch\xFAng (pha c\u1EE7a S\xF3ng 2 so v\u1EDBi
    S\xF3ng 1). H\u01B0\u1EDBng c\u1EE7a S\xF3ng 1 c\xF3 th\u1EC3 \u0111\u01B0\u1EE3c
    \u0111\u1EA3o ng\u01B0\u1EE3c \u0111\u1EC3 nghi\xEAn c\u1EE9u c\xE1c s\xF3ng
    di chuy\u1EC3n theo h\u01B0\u1EDBng ng\u01B0\u1EE3c nhau.\n\n\u0110\u1EC3 nghi\xEAn
    c\u1EE9u s\u1EF1 t\u01B0\u01A1ng t\xE1c gi\u1EEFa \xE1nh s\xE1ng v\xE0 v\u1EADt
    ch\u1EA5t, m\u1ED9t kh\u1ED1i v\u1EADt ch\u1EA5t c\xF3 th\u1EC3 \u0111\u01B0\u1EE3c
    ch\xE8n v\xE0o gi\u1EEFa hai m\u1EB7t ph\u1EB3ng. Chi\u1EC1u d\xE0i c\u1EE7a
    kh\u1ED1i v\u1EADt ch\u1EA5t n\xE0y c\u0169ng nh\u01B0 c\xE1c h\u1EC7 s\u1ED1
    suy gi\u1EA3m v\xE0 ch\u1EC9 s\u1ED1 kh\xFAc x\u1EA1 cho c\u1EA3 hai s\xF3ng
    c\xF3 th\u1EC3 \u0111\u01B0\u1EE3c \u0111i\u1EC1u ch\u1EC9nh b\u1EB1ng c\xE1c
    \u0111i\u1EC1u khi\u1EC3n.\n\nT\u1ED1c \u0111\u1ED9 c\u1EE7a m\xF4 ph\u1ECFng
    c\xF3 th\u1EC3 \u0111\u01B0\u1EE3c thi\u1EBFt l\u1EADp, v\xE0 c\xF3 t\xF9y ch\u1ECDn
    ch\u1EC9 hi\u1EC3n th\u1ECB c\xE1c vector t\u1EA1i c\xE1c m\u1EB7t ph\u1EB3ng
    m\xE0 kh\xF4ng c\xF3 d\u1EA1ng s\xF3ng \u1EDF gi\u1EEFa \u0111\u1EC3 vi\u1EC7c
    so s\xE1nh chuy\u1EC3n \u0111\u1ED9ng c\u1EE7a c\xE1c vector tr\u1EDF n\xEAn
    d\u1EC5 d\xE0ng h\u01A1n.\n\nB\u1EB1ng c\xE1ch s\u1EED d\u1EE5ng menu Hi\u1EC7n
    t\u01B0\u1EE3ng, b\u1EA1n c\xF3 th\u1EC3 ch\u1ECDn t\u1EEB nhi\u1EC1u t\u1EADp
    h\u1EE3p th\xF4ng s\u1ED1 \u0111\u1ECBnh tr\u01B0\u1EDBc t\u01B0\u01A1ng \u1EE9ng
    v\u1EDBi c\xE1c hi\u1EC7n t\u01B0\u1EE3ng \u0111i\u1EC7n t\u1EEB kh\xE1c nhau.
    Khi m\u1ED9t hi\u1EC7n t\u01B0\u1EE3ng \u0111\u01B0\u1EE3c ch\u1ECDn, m\u1ED9t
    l\u1EDDi gi\u1EA3i th\xEDch ng\u1EAFn v\u1EC1 n\xF3 s\u1EBD \u0111\u01B0\u1EE3c
    hi\u1EC3n th\u1ECB.\n\nC\u1EA3nh c\xF3 th\u1EC3 \u0111\u01B0\u1EE3c xoay v\xE0
    ph\xF3ng to (xem menu Tr\u1EE3 gi\xFAp \u0111\u1EC3 bi\u1EBFt c\xE1ch th\u1EF1c
    hi\u1EC7n). Menu Xem ch\u1EE9a m\u1ED9t s\u1ED1 g\xF3c nh\xECn camera \u0111\u1ECBnh
    s\u1EB5n \u0111\u1EC3 d\u1EC5 d\xE0ng quan s\xE1t c\u1EA3nh, v\xE0 b\u1EA1n c\u0169ng
    c\xF3 th\u1EC3 chuy\u1EC3n sang ch\u1EBF \u0111\u1ED9 to\xE0n m\xE0n h\xECnh.\n\nN\u1EBFu
    b\u1EA1n kh\xF4ng th\xEDch b\u1EA3ng m\xE0u m\u1EB7c \u0111\u1ECBnh, b\u1EA1n
    c\xF3 th\u1EC3 t\u1EF1 thi\u1EBFt l\u1EADp m\xE0u s\u1EAFc c\u1EE7a m\xECnh b\u1EB1ng
    c\xE1ch s\u1EED d\u1EE5ng menu M\xE0u."
